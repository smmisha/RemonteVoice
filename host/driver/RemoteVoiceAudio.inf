; UNSIGNED DEVELOPMENT TEMPLATE. Never installed by build.py.
[Version]
Signature   = "$Windows NT$"
Class       = MEDIA
Provider    = %ProviderName%
ClassGUID   = {4d36e96c-e325-11ce-bfc1-08002be10318}
DriverVer   = 10/24/2026, 0.0.1.0
CatalogFile = RemoteVoiceAudio.cat
PnpLockDown = 1

[SourceDisksNames]
222="REMOTEVOICEAUDIO Driver Disk","",222

[SourceDisksFiles]
RemoteVoiceAudio.sys=222

[Manufacturer]
%MfgName%=REMOTEVOICEAUDIO,NTamd64.10.0...22000

[REMOTEVOICEAUDIO.NTamd64.10.0...22000]
%REMOTEVOICEAUDIO_SA.DeviceDesc%=REMOTEVOICEAUDIO_SA, ROOT\RemoteVoiceAudio

[DestinationDirs]
REMOTEVOICEAUDIO_SA.CopyList=13 ; 13=Package's DriverStore directory

;======================================================
; REMOTEVOICEAUDIO_SA
;======================================================
[REMOTEVOICEAUDIO_SA.CopyList]
RemoteVoiceAudio.sys

[REMOTEVOICEAUDIO_SA.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,RemoteVoiceAudio.sys

;
; For demo only, please review these power management settings for your architecture.
;
HKR,PowerSettings,SingleComponentMultiFxStates,3,1,0,0,0  ; Turn on multi Fx support.
HKR,PowerSettings,ConservationIdleTime,3,3,0,0,0          ; 3 seconds for idle power management when on battery
HKR,PowerSettings,PerformanceIdleTime,3,3,0,0,0           ; 3 seconds for idle power management when on AC power
HKR,PowerSettings,IdlePowerState,3,3,0,0,0                ; go to D3 for idle power management

HKR,Drivers,SubClasses,,"wave,midi,mixer"

HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv

HKR,Drivers\wave\wdmaud.drv,Description,,%REMOTEVOICEAUDIO_SA.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%REMOTEVOICEAUDIO_SA.DeviceDesc%

;======================================================
; capture interfaces: mic array (internal: front)
;======================================================
[REMOTEVOICEAUDIO.I.WaveMicArray1]
AddReg=REMOTEVOICEAUDIO.I.WaveMicArray1.AddReg
[REMOTEVOICEAUDIO.I.WaveMicArray1.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%REMOTEVOICEAUDIO.WaveMicArray1.szPname%

[REMOTEVOICEAUDIO.I.TopologyMicArray1]
AddReg=REMOTEVOICEAUDIO.I.TopologyMicArray1.AddReg

[REMOTEVOICEAUDIO.I.TopologyMicArray1.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%REMOTEVOICEAUDIO.TopologyMicArray1.szPname%

HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%

; The following lines opt-in to pull mode.
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

;======================================================
; render interfaces: speaker (internal)
;======================================================
[REMOTEVOICEAUDIO.I.WaveSpeaker]
AddReg=REMOTEVOICEAUDIO.I.WaveSpeaker.AddReg

[REMOTEVOICEAUDIO.I.WaveSpeaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%REMOTEVOICEAUDIO.WaveSpeaker.szPname%

[REMOTEVOICEAUDIO.I.TopologySpeaker]
AddReg=REMOTEVOICEAUDIO.I.TopologySpeaker.AddReg

[REMOTEVOICEAUDIO.I.TopologySpeaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%REMOTEVOICEAUDIO.TopologySpeaker.szPname%

HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%

; The following lines opt-in to pull mode.
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

;======================================================
; REMOTEVOICEAUDIO_SA
;======================================================
[REMOTEVOICEAUDIO_SA.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration, WDMAUDIO.Registration
CopyFiles=REMOTEVOICEAUDIO_SA.CopyList
AddReg=REMOTEVOICEAUDIO_SA.AddReg

[REMOTEVOICEAUDIO_SA.NT.Interfaces]
;
; Interfaces for speaker (internal) render endpoint.
;
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_WaveSpeaker%, REMOTEVOICEAUDIO.I.WaveSpeaker
AddInterface=%KSCATEGORY_RENDER%, %KSNAME_WaveSpeaker%, REMOTEVOICEAUDIO.I.WaveSpeaker
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_WaveSpeaker%, REMOTEVOICEAUDIO.I.WaveSpeaker
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_TopologySpeaker%, REMOTEVOICEAUDIO.I.TopologySpeaker
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopologySpeaker%, REMOTEVOICEAUDIO.I.TopologySpeaker

;
; Interfaces for microphone array 1 (internal: front) capture endpoint.
;
AddInterface=%KSCATEGORY_AUDIO%,    %KSNAME_WaveMicArray1%, REMOTEVOICEAUDIO.I.WaveMicArray1
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_WaveMicArray1%, REMOTEVOICEAUDIO.I.WaveMicArray1
AddInterface=%KSCATEGORY_CAPTURE%,  %KSNAME_WaveMicArray1%, REMOTEVOICEAUDIO.I.WaveMicArray1
AddInterface=%KSCATEGORY_AUDIO%,    %KSNAME_TopologyMicArray1%, REMOTEVOICEAUDIO.I.TopologyMicArray1
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyMicArray1%, REMOTEVOICEAUDIO.I.TopologyMicArray1

[REMOTEVOICEAUDIO_SA.NT.Services]
AddService=RemoteVoiceAudio,0x00000002,RemoteVoiceAudio_Service_Inst

[RemoteVoiceAudio_Service_Inst]
DisplayName=%RemoteVoiceAudio.SvcDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\RemoteVoiceAudio.sys

[REMOTEVOICEAUDIO_SA.NT.HW]
AddReg = AUDIOHW.AddReg

[AUDIOHW.AddReg]
; FILE_DEVICE_SOUND
HKR,,DeviceType,0x10001,0x0000001D
; Standard Windows audio-engine access, including its restricted token.
; Private PCM commands separately require SYSTEM/administrator access in kernel.
; A separately authenticated production ingress service is not implemented.
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"


;======================================================
; WDF
;======================================================
[REMOTEVOICEAUDIO_SA.NT.Wdf]
KmdfService = RemoteVoiceAudio, REMOTEVOICEAUDIO_SA_WdfSect
[REMOTEVOICEAUDIO_SA_WdfSect]
KmdfLibraryVersion = 1.15

;======================================================
; COMMON
;======================================================
[Strings]

;Non-localizable

KSNAME_WaveSpeaker="WaveSpeaker"
KSNAME_TopologySpeaker="TopologySpeaker"

KSNAME_WaveMicArray1="WaveMicArray1"
KSNAME_TopologyMicArray1="TopologyMicArray1"

Proxy.CLSID="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_CAPTURE="{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME ="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY = "{DDA54A40-1E4C-11D1-A050-405705C10000}"

KSNODETYPE_ANY   = "{00000000-0000-0000-0000-000000000000}"

PKEY_AudioEndpoint_Association               = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioEndpoint_Supports_EventDriven_Mode = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"

;Localizable

ProviderName = "RemoteVoice Development"
MfgName      = "RemoteVoice Development"
MsCopyRight  = "RemoteVoice contributors; Microsoft sample portions retain original notices"

REMOTEVOICEAUDIO_SA.DeviceDesc="RemoteVoice Audio Development"
RemoteVoiceAudio.SvcDesc="RemoteVoice Audio Development Driver"

;; friendly names
REMOTEVOICEAUDIO.WaveSpeaker.szPname="RemoteVoice System Audio"
REMOTEVOICEAUDIO.TopologySpeaker.szPname="RemoteVoice System Audio Topology"

REMOTEVOICEAUDIO.WaveMicArray1.szPname="RemoteVoice Microphone"
REMOTEVOICEAUDIO.TopologyMicArray1.szPname="RemoteVoice Microphone Topology"

MicArray1CustomName= "RemoteVoice Microphone"
